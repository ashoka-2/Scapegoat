
# ── Pinecone vector database (text + image embeddings) ─────────────────────
# API key is enough — the SDK resolves the serverless index hosts from it.
# PINECONE_CLOUD / PINECONE_REGION are only used when CREATING the indexes
# (defaults: aws / us-east-1). Index names default to scapegoat-text / scapegoat-image.
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_TEXT_INDEX=scapegoat-text
PINECONE_IMAGE_INDEX=scapegoat-image
