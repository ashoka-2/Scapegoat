
# ── Voyage AI embeddings (replaces local Transformers.js/MiniLM/CLIP) ─────────
# Required. Text + image embeddings for semantic & visual search (1024-dim).
# Model: voyage-multimodal-3.5 (text AND images, one consistent vector space).
VOYAGE_API_KEY=
# Optional overrides:
VOYAGE_MODEL=voyage-multimodal-3.5
VOYAGE_EMBEDDING_DIM=1024

# ── Pinecone vector database (PRIMARY vector search — same Voyage vectors) ───
# API key is enough — the SDK resolves the serverless index hosts from it.
# PINECONE_CLOUD / PINECONE_REGION are only used when CREATING the indexes
# (defaults: aws / us-east-1). The indexes are 1024-dim Voyage indexes —
# NEW names (the old 384d/512d MiniLM/CLIP indexes are left untouched).
PINECONE_API_KEY=
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_TEXT_INDEX=scapegoat-voyage-text
PINECONE_IMAGE_INDEX=scapegoat-voyage-image

# ── MongoDB Atlas Vector Search (FALLBACK when Pinecone is unavailable) ──────
# Indexes are auto-created at boot when the connection has Atlas admin rights;
# otherwise create them once in the Atlas UI (see src/services/mongoVectorSearch.service.js):
#   voyage_text        → products.embedding           (1024d, cosine)
#   voyage_image_root  → products.imageEmbedding      (1024d, cosine)
#   voyage_images_nest → products.images.embedding    (1024d, cosine)
